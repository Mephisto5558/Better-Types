{
  "name": "@mephisto5558/better-types",
  "version": "2.3.0",
  "description": "A collection of useful TypeScript types and augmentations to improve developer experience.",
  "keywords": [
    "typescript",
    "typing"
  ],
  "homepage": "https://github.com/Mephisto5558/Better-Types#readme",
  "bugs": {
    "url": "https://github.com/Mephisto5558/Better-Types/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mephisto5558/Better-Types.git"
  },
  "license": "MIT",
  "author": "Mephisto5558",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./eslint": {
      "types": "./src/eslint.d.ts",
      "import": "./src/eslint.js",
      "require": "./src/eslint.js"
    }
  },
  "main": "./src/index.d.ts",
  "types": "src/index.d.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint . --cache --cache-location ./node_modules/.cache/eslint/ >eslint.log",
    "test": "tsd tests --files **/*.test-d.ts"
  },
  "devDependencies": {
    "@mephisto5558/eslint-config": "latest",
    "@types/node": "20.x",
    "better-typescript-lib": "latest",
    "tsd": "^0.33.0"
  },
  "peerDependencies": {
    "@types/node": ">=20",
    "better-typescript-lib": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": "^22.22.2 || >=24.15.0"
    }
  }
}
